# Where They Are: every environment variable used across the monorepo.
# Copy the section you need into that app's own .env file (for example
# apps/server/.env). Values below are local development defaults.
# Leave secrets empty here and set them in your deployment platform instead.

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
NODE_ENV=development

# ---------------------------------------------------------------------------
# apps/dealership-demo (Ridgeline Motors sample site, port 3002)
# NEXT_PUBLIC_* values are baked in at build time: make them available
# during the build (Docker build args / "Available during build").
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3002
# Where They Are WhatsApp number, international format, digits only.
NEXT_PUBLIC_WTA_WHATSAPP_NUMBER=263775101506

# docker-compose build args for the dealership-demo service (root .env).
DEALERSHIP_DEMO_SITE_URL=http://localhost:3002
WTA_WHATSAPP_NUMBER=263775101506

# ---------------------------------------------------------------------------
# apps/web (customer portal, port 3001)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SERVER_BASE_URL=http://localhost:3100

# ---------------------------------------------------------------------------
# apps/server (NestJS API, port 3100)
# ---------------------------------------------------------------------------
SERVER_PORT=3100
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wheretheyare?schema=public
DATABASE_ENABLED=false
PORTAL_ORIGIN=http://localhost:3001
PUBLIC_SITE_ORIGIN=http://localhost:3103
PREVIEW_SITE_ORIGIN=http://localhost:3103

# OpenRouter and Jev routing (also used by apps/worker-whatsapp).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3-flash-preview
JEV_ENABLED=true
JEV_MODEL=~typesafe/jev-latest
JEV_MIN_CONFIDENCE=0.75
JEV_FAIL_OPEN=true

# Coolify deployment (optional; disabled until the deployment server exists).
COOLIFY_API_URL=
COOLIFY_API_TOKEN=
COOLIFY_SITE_RESOURCE_UUID=

# ---------------------------------------------------------------------------
# apps/worker-whatsapp (WhatsApp worker, port 3101)
# Also needs OPENROUTER_* and JEV_* from the server section.
# ---------------------------------------------------------------------------
WHATSAPP_WORKER_PORT=3101
WHATSAPP_AUTH_PATH=.wwebjs_auth
WHATSAPP_CLIENT_ID=wheretheyare
# Optional explicit Chrome/Chromium executable on the VPS.
CHROME_EXECUTABLE_PATH=
SERVER_BASE_URL=http://localhost:3100

# ---------------------------------------------------------------------------
# apps/whatsapp-agent (Angel, the dealership WhatsApp agent, port 3104)
# Goes in apps/whatsapp-agent/.env. Never link it and worker-whatsapp to the
# same number. It also reads OPENROUTER_API_KEY and CHROME_EXECUTABLE_PATH,
# and uses its own values for these shared names:
#   WHATSAPP_AUTH_PATH=./data/wwebjs_auth
#   WHATSAPP_CLIENT_ID=angel
# ---------------------------------------------------------------------------
AGENT_PORT=3104
AGENT_MODEL=google/gemini-3.8-flash
# minimal, low, medium or high (Gemini 3 cannot turn reasoning off).
AGENT_REASONING_EFFORT=low
# Mastra memory and the CRM (crm.sqlite). /data in Docker.
AGENT_DATA_DIR=./data
OWNER_WHATSAPP_NUMBER=263789859332
DEMO_SITE_URL=https://dealership-demo.wheretheyare.co.zw
DEALERSHIP_EARLY_PRICE_USD=250
DEALERSHIP_STANDARD_PRICE_USD=400
DEALERSHIP_EARLY_PRICE_SLOTS=5
DEALERSHIP_EARLY_SLOTS_USED_OFFSET=0
# Empty disables the admin API.
ADMIN_TOKEN=
WHATSAPP_ENABLED=true
# Business number for pairing-code login; empty means QR login.
WHATSAPP_PAIRING_NUMBER=
REPLY_DEBOUNCE_MS=3500
HUMAN_TAKEOVER_HOURS=12
MAX_REPLIES_PER_HOUR=30
# Paynow mobile checkout for the $125 deposit and balance. Empty = the owner
# is alerted to collect payment by hand. Paynow posts results to
# <PUBLIC_BASE_URL>/api/paynow/result; Angel also polls.
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_AUTH_EMAIL=
PUBLIC_BASE_URL=
# Meta Conversions API (qualified leads, deposit requests, payments). Empty = off.
META_DATASET_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# apps/worker-jobs (background jobs, port 3102)
# Also uses SERVER_BASE_URL.
# ---------------------------------------------------------------------------
JOBS_WORKER_PORT=3102

# ---------------------------------------------------------------------------
# apps/site-origin (published and preview sites, port 3103)
# Also uses SERVER_BASE_URL.
# ---------------------------------------------------------------------------
SITE_ORIGIN_PORT=3103

# ---------------------------------------------------------------------------
# packages/db (Prisma) uses DATABASE_URL from the server section.
# packages/test-kit (smoke and e2e scripts)
# ---------------------------------------------------------------------------
SITE_ORIGIN_BASE_URL=http://localhost:3103
COOLIFY_CHECKS_ENABLED=false
