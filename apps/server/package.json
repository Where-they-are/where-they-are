{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "dev": "node --import tsx --import varlock/auto-load --watch src/main.ts",
    "env:generate": "varlock codegen",
    "start": "node --import varlock/auto-load dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@mastra/core": "^1.67.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@where-they-are/contracts": "workspace:*",
    "@where-they-are/db": "workspace:*",
    "@where-they-are/jev-router": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "catalog:",
    "@where-they-are/config": "workspace:*",
    "tsx": "^4.20.6",
    "typescript": "catalog:",
    "vitest": "^5.0.1"
  }
}
