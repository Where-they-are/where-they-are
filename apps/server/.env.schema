# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

SERVER_PORT=3100
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wheretheyare?schema=public
DATABASE_ENABLED=false
PORTAL_ORIGIN=http://localhost:3001
PUBLIC_SITE_ORIGIN=http://localhost:3103
PREVIEW_SITE_ORIGIN=http://localhost:3103

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3-flash-preview
JEV_ENABLED=true
JEV_MODEL=~typesafe/jev-latest
JEV_MIN_CONFIDENCE=0.75
JEV_FAIL_OPEN=true

# Coolify is deliberately disabled until the larger deployment server is available.
# @required=false
COOLIFY_API_URL=
# @required=false
COOLIFY_API_TOKEN=
# @required=false
COOLIFY_SITE_RESOURCE_UUID=
