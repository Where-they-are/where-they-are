# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# OpenRouter gateway credentials and model routing.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3-flash-preview
JEV_ENABLED=true
JEV_MODEL=~typesafe/jev-latest
JEV_MIN_CONFIDENCE=0.75
JEV_FAIL_OPEN=true

# Persistent WhatsApp Web session storage.
WHATSAPP_AUTH_PATH=.wwebjs_auth
WHATSAPP_CLIENT_ID=wheretheyare

# Optional explicit Chrome/Chromium executable on the VPS.
CHROME_EXECUTABLE_PATH=

# Worker HTTP health port.
WHATSAPP_WORKER_PORT=3101
SERVER_BASE_URL=http://localhost:3100
