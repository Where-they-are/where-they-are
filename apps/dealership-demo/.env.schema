# @defaultRequired=true
# @defaultSensitive=false
# @currentEnv=$NODE_ENV
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Public origin of the deployed demo, used for canonical and Open Graph URLs.
# @public @type=url
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Where They Are WhatsApp Business number in international format, digits only
# (for example 263771234567). Every "Get one like it" and dealership contact
# action opens a chat with this number. When empty, links open WhatsApp without
# a recipient so the visitor can still choose who to send the prefilled message to.
# @public @required=false
NEXT_PUBLIC_WTA_WHATSAPP_NUMBER=
