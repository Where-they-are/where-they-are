{
  "name": "@where-they-are/whatsapp-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "chat": "node --import tsx --import varlock/auto-load scripts/chat.ts",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "dev": "node --import tsx --import varlock/auto-load --watch src/main.ts",
    "eval": "node --import tsx --import varlock/auto-load scripts/eval.ts",
    "media-check": "node --import tsx --import varlock/auto-load scripts/media-check.ts",
    "relevance-eval": "node --import tsx --import varlock/auto-load scripts/relevance-eval.ts",
    "start": "node --import varlock/auto-load dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@mastra/core": "^1.67.0",
    "@mastra/libsql": "1.23.0",
    "@mastra/memory": "1.28.2",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@where-they-are/jev-router": "workspace:*",
    "@where-they-are/paynow": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "varlock": "catalog:",
    "whatsapp-web.js": "^1.34.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "catalog:",
    "@where-they-are/config": "workspace:*",
    "tsx": "^4.20.6",
    "typescript": "catalog:",
    "vitest": "^5.0.1"
  }
}
