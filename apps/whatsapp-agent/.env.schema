# @defaultRequired=true
# @defaultSensitive=false
# @currentEnv=$NODE_ENV
# ---

# @type=enum(development, production, test)
NODE_ENV=development

# HTTP port for health, the admin API and the WhatsApp login status.
AGENT_PORT=3104

# OpenRouter credentials and the chat model Angel runs on.
# @sensitive
OPENROUTER_API_KEY=
AGENT_MODEL=google/gemini-3.8-flash
# How much hidden reasoning the model does per reply: minimal, low, medium or
# high. Lower is faster and cheaper; Gemini 3 models cannot turn it off.
AGENT_REASONING_EFFORT=low

# Where Angel keeps conversation memory (Mastra, libsql) and the CRM (SQLite).
AGENT_DATA_DIR=./data

# The owner's personal WhatsApp number (international format). Receives
# hand-off alerts and can send #commands to Angel.
OWNER_WHATSAPP_NUMBER=263789859332

# The dealership demo Angel shares with leads.
DEMO_SITE_URL=https://dealership-demo.wheretheyare.co.zw

# Dealership pricing: the early price applies to the first N signed dealerships.
DEALERSHIP_EARLY_PRICE_USD=250
DEALERSHIP_STANDARD_PRICE_USD=400
DEALERSHIP_EARLY_PRICE_SLOTS=5
# Dealerships signed outside Angel's CRM that count towards the early slots.
# @required=false
DEALERSHIP_EARLY_SLOTS_USED_OFFSET=0

# Protects the admin API. Leave empty to disable the admin API entirely.
# @sensitive @required=false
ADMIN_TOKEN=

# WhatsApp Web transport. Disable to run the HTTP API without a phone session.
WHATSAPP_ENABLED=true
WHATSAPP_AUTH_PATH=./data/wwebjs_auth
WHATSAPP_CLIENT_ID=angel
# Link the session with an 8-character pairing code instead of a QR code by
# setting the business number here (international format, digits only).
# @required=false
WHATSAPP_PAIRING_NUMBER=
# @required=false
CHROME_EXECUTABLE_PATH=

# Conversation behaviour.
# Wait this long after a customer's last message before replying, so several
# quick messages get one answer.
REPLY_DEBOUNCE_MS=3500
# How long Angel stays quiet in a chat after the owner replies there by hand.
HUMAN_TAKEOVER_HOURS=12
# Cap on Angel's replies per customer per hour, to contain abuse and cost.
MAX_REPLIES_PER_HOUR=30

# Paynow mobile checkout (EcoCash / OneMoney) for the deposit and balance.
# Leave empty to have Angel hand payments to the owner instead.
# @required=false
PAYNOW_INTEGRATION_ID=
# @sensitive @required=false
PAYNOW_INTEGRATION_KEY=
# The merchant's Paynow login email (required by Paynow; in test mode it must be this email).
# @required=false
PAYNOW_AUTH_EMAIL=
# Angel's public address, e.g. https://angel.wheretheyare.co.zw. Paynow POSTs
# results to <this>/api/paynow/result; Angel also polls, so it still works without it.
# @required=false
PUBLIC_BASE_URL=

# Meta Conversions API: report qualified leads, deposit requests and payments.
# Leave empty to skip reporting.
# @required=false
META_DATASET_ID=
# @sensitive @required=false
META_CAPI_TOKEN=
# Events Manager > Test events code, while testing. Remove for live reporting.
# @required=false
META_TEST_EVENT_CODE=
# Improves Click-to-WhatsApp attribution when WhatsApp reports the ad click id.
# @required=false
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
