    "@where-they-are/server-client": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@where-they-are/config": "workspace:*",
    "tsx": "^4.20.6",
    "typescript": "catalog:",
    "vitest": "^5.0.1"
  }
